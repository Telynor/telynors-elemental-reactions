<section class="ter-wizard"><div class="ter-two"><label>First Element<select name="a">{{#each elements}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label>Second Element<select name="b">{{#each elements}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label></div><label>Reaction Name<input name="name" placeholder="Frostburn"></label><fieldset><legend>Damage Element</legend><div class="ter-two"><label>Element<select name="damageElement">{{#each elements}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><label>Amount<input name="formula" placeholder="2d6"></label></div><label>Damage Type<input name="damageType" placeholder="cold"></label></fieldset><fieldset><legend>Summon an Entity?</legend><div class="ter-drop" data-action="actor-drop">Drop an Actor here<input name="actorUuid" placeholder="Actor UUID"></div><div class="ter-two"><label>Quantity<input name="quantity" type="number" value="1" min="1"></label><label>Lifetime (turns)<input name="lifetime" type="number" value="2" min="1"></label></div></fieldset><fieldset><legend>Zone</legend><label><input name="zone" type="checkbox"> Creates a visible zone</label><div class="ter-two"><label>Radius (ft)<input name="radius" type="number" value="10"></label><label>One-time Damage<input name="zoneDamage" placeholder="blank = element only"></label></div><label>Zone Damage Type<input name="zoneDamageType" placeholder="acid"></label></fieldset><fieldset><legend>Text Designer</legend><div class="ter-two"><label>Fill<select name="textMode"><option value="gradient">Gradient</option><option value="solid">Solid</option><option value="element-gradient">Element Gradient</option></select></label><label>Direction<select name="direction"><option value="right">Left → Right</option><option value="left">Right → Left</option><option value="up">Bottom → Top</option><option value="down">Top → Bottom</option></select></label></div><label>Solid Color<input name="solid" type="color" value="#ffffff"></label><div class="ter-preview">REACTION</div></fieldset><button type="button" data-action="save"><i class="fa-solid fa-floppy-disk"></i> Save Reaction</button></section>