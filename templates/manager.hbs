<section class="ter-manager"><header><h2>Telynor's Elemental Reactions</h2><div><button type="button" data-action="add-element"><i class="fa-solid fa-plus"></i> Element</button><button type="button" data-action="add-reaction"><i class="fa-solid fa-wand-magic-sparkles"></i> Reaction Wizard</button><button type="button" data-action="add-variant"><i class="fa-solid fa-code-branch"></i> Variant</button><button type="button" data-action="export"><i class="fa-solid fa-download"></i> Export</button></div></header><h3>Elements</h3><div class="ter-grid">{{#each elements}}<article><img src="{{icon}}"><strong>{{name}}</strong><code>{{id}}</code><span class="ter-swatch" style="--c:{{color}}"></span></article>{{/each}}</div><h3>Reaction Directory</h3><table><thead><tr><th>Elements</th><th>Reaction</th><th>Effects</th></tr></thead><tbody>{{#each reactions}}<tr><td>{{elements.[0]}} + {{elements.[1]}}</td><td>{{name}}</td><td>{{effects.length}}</td></tr>{{/each}}</tbody></table><h3>Variant Overrides</h3><p>Higher priority variants win when multiple overrides are eligible.</p><div class="ter-variants">{{#each variants}}<article><strong>{{name}}</strong><span>Priority {{priority}}</span></article>{{else}}<em>No variants yet.</em>{{/each}}</div></section>