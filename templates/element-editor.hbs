<section class="ter-wizard"><h2>{{#if isNew}}Create Element{{else}}Edit {{element.name}}{{/if}}</h2><label>Name<input name="name" value="{{element.name}}" placeholder="Fire"></label><label>Element ID<input name="id" value="{{element.id}}" {{#unless isNew}}disabled{{/unless}} placeholder="fire"></label><fieldset><legend>Icon</legend><div class="ter-icon-editor"><img class="ter-icon-preview" src="{{element.icon}}"><input name="icon" value="{{element.icon}}" placeholder="icons/my-element.webp"><button type="button" data-action="browse-icon"><i class="fa-solid fa-folder-open"></i> Browse / Upload</button></div><p><small>The Browse button opens Foundry's file picker. Use its Upload control to add PNG, WEBP, SVG, or other Foundry-supported images.</small></p></fieldset><div class="ter-two"><label>Primary Color<input name="color" type="color" value="{{element.color}}"></label><label>Glow Color<input name="glow" type="color" value="{{element.glow}}"></label></div><label>Associated damage types<input name="damageTypes" value="{{damageTypes}}" placeholder="fire, acid"></label><div class="ter-element-preview"><img src="{{element.icon}}"><strong>{{element.name}}</strong></div><footer><button type="button" data-action="save"><i class="fa-solid fa-floppy-disk"></i> Save</button>{{#unless isNew}}<button type="button" data-action="delete"><i class="fa-solid fa-trash"></i> Delete</button>{{/unless}}</footer></section>