<section class="ter-character-picker"><h2>{{actorName}}</h2><p>Choose this character's active elemental infusion.</p><label>Active Element<select name="activeElement"><option value="">None</option>{{#each elements}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label><p><strong>Infusion:</strong> {{#if infused}}Enabled{{else}}Disabled{{/if}}</p><p class="hint">{{#if isGM}}GM view shows every element.{{else}}Only elements unlocked for this character by the GM appear here.{{/if}}</p></section>